{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LabSlot: Verify P0-P4 and all GUI workflows",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Analyze", "-Test", "-GuiTest"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "LabSlot: Build GUI and test",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-GuiTest"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "LabSlot: Run GUI",
      "type": "process",
      "command": "${workspaceFolder}/LabSlot-GUI.exe",
      "dependsOn": "LabSlot: Build C11",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    },
    {
      "label": "LabSlot: Build C11",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "LabSlot: Build and test P0 + P1 + P2 + P3 + P4",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/build.ps1", "-Test"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": "test",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "LabSlot: Run",
      "type": "process",
      "command": "${workspaceFolder}/smart-lab.exe",
      "dependsOn": "LabSlot: Build C11",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
